{
  "name": "dawidkotarba.github.io",
  "version": "1.0.0",
  "description": "My resume, under construction forever :)",
  "main": "index.html",
  "scripts": {
    "clean": "gulp clean",
    "build": "gulp build",
    "rebuild": "rm -rf node_modules dist package-lock.json && npm install && npm run build",
    "serve": "gulp default",
    "test-firefox": "cypress run --headless --browser firefox --env host=index.html",
    "test-chrome": "cypress run --headless --browser electron --env host=index.html",
    "testall": "npm run test-firefox && npm run test-chrome",
    "test": "npm run test-chrome",
    "test-firefox-prod": "cypress run --headless --browser firefox --env host=https://dawidkotarba.eu",
    "test-chrome-prod": "cypress run --headless --browser chrome --env host=https://dawidkotarba.eu",
    "test-prod": "npm run test-firefox-prod && npm run test-chrome-prod",
    "cypress": "cypress open --env host=index.html"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawidkotarba/dawidkotarba.github.io.git"
  },
  "author": "Dawid Kotarba",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/dawidkotarba/dawidkotarba.github.io/issues"
  },
  "homepage": "https://github.com/dawidkotarba/dawidkotarba.github.io#readme",
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.9.6",
    "animate.css": "^4.1.1",
    "browser-sync": "^3.0.4",
    "cypress": "^15.17.0",
    "del": "^8.0.1",
    "fancy-log": "^2.0.0",
    "gulp": "^5.0.1",
    "gulp-babel": "^8.0.0",
    "gulp-clean-css": "^4.3.0",
    "gulp-concat": "^2.6.1",
    "gulp-htmlmin": "^5.0.1",
    "gulp-plumber": "^1.2.1",
    "gulp-rename": "^2.0.0",
    "gulp-sass": "^6.0.1",
    "gulp-uglify": "^3.0.2",
    "rxjs": "^7.8.2",
    "sass": "^1.100.0",
    "zen-observable": "^0.10.0"
  },
